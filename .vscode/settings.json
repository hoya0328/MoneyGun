{
  "files.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.vite": true,
    "**/artifacts": true,
    "**/logs": true,
    "**/tmp": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/.venv": true,
    "**/artifacts": true
  },
  "editor.formatOnSave": true,
  "editor.rulers": [100],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
