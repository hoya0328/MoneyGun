# Runtime
MONEYGUN_ENV=local
MONEYGUN_LOG_LEVEL=INFO
MONEYGUN_DATABASE_PATH=data/moneygun.sqlite3
MONEYGUN_DATABASE_BACKEND=sqlite
MONEYGUN_DATABASE_URL=postgresql://moneygun:change-me@localhost:5432/moneygun
MONEYGUN_OBJECT_STORAGE_URL=http://localhost:9000
MONEYGUN_MARKET_DATA_IMPORT_DIR=data/imports
VITE_API_BASE_URL=http://127.0.0.1:8000

# Authentication — configure through an OIDC provider in non-local environments
MONEYGUN_OIDC_ISSUER=
MONEYGUN_OIDC_CLIENT_ID=
MONEYGUN_SECRET_BACKEND=
MONEYGUN_ERROR_MONITOR_DSN=
MONEYGUN_PUBLIC_ORIGIN=
MONEYGUN_MANAGED_BACKUP_CONFIGURED=false

# DESKTOP_LIVE — generated/probed by scripts/start-desktop-live.ps1.
# Do not set these to true manually; the supervisor and recovery records must prove them.
MONEYGUN_KIWOOM_REGISTERED_IP=
MONEYGUN_DESKTOP_AUTOSTART_CONFIGURED=false
MONEYGUN_SLEEP_DISABLED=false
MONEYGUN_CLOCK_SYNCHRONIZED=false
MONEYGUN_OBSERVED_PUBLIC_IP=
MONEYGUN_DESKTOP_LOGGING_CONFIGURED=false
MONEYGUN_BACKUP_ENCRYPTION_CONFIRMED=false
MONEYGUN_WINDOWS_SECRETS_LOADED=false

# LLM providers — never put real values in committed files
OPENAI_API_KEY=

# Research data — OpenDART keys are issued by the official service
OPENDART_API_KEY=
DATA_GO_KR_SERVICE_KEY=
# Broker — local/shadow development may use ignored .env values.
# DESKTOP_LIVE ignores these secret fields in .env and loads DPAPI-encrypted values instead.
KIWOOM_ENVIRONMENT=production
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_ACCOUNT_ALIAS=키움 주계좌
# Kiwoom issues one production App Key pair per registered account. MoneyGun requires
# an explicit second binding for the isolated order process; it may reference the same
# production pair, but the application never copies or falls back automatically.
KIWOOM_ORDER_ENVIRONMENT=production
KIWOOM_ORDER_APP_KEY=
KIWOOM_ORDER_SECRET_KEY=
KIWOOM_TRADING_ENABLED=false
MONEYGUN_RELEASE_APPROVED=false
MONEYGUN_OWNER_API_TOKEN=
MONEYGUN_LIVE_CAPITAL_KRW=100000
MONEYGUN_L0_CAPITAL_KRW=50000
